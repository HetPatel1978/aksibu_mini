# ============================================================
# AKSIBU MINI — ENVIRONMENT CONFIGURATION
# ============================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your OpenRouter API key below
# 3. Get your key from: https://openrouter.ai/keys
# 4. Never commit .env to git
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-o....................your key

# ── MODELS ───────────────────────────────────────────────────
CHEAP_MODEL=anthropic/claude-haiku-4-5
FRONTIER_MODEL=anthropic/claude-sonnet-4-5
AGENT_MODEL=anthropic/claude-sonnet-4-5

# ── ALTERNATIVE CHEAP OPTIONS ────────────────────────────────
# CHEAP_MODEL=google/gemini-flash-1.5
# CHEAP_MODEL=meta-llama/llama-3.1-8b-instruct

# ── COST CONTROLS ─────────────────────────────────────────────
MAX_AGENT_TOOL_CALLS=7
MAX_EXTRACTION_TOKENS=800
